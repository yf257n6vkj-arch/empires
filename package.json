  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "undici": "^7.30.2",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
